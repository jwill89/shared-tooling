{
  // The app's sources: Vue's own DOM base, plus the checks five of the front ends
  // already turn on. The project adds its `include`, `types` and `paths`:
  //
  //   { "extends": "@jwill89/lint-web/tsconfig.app.json", "include": ["src"] }
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // An index into an array or a record may find nothing, and the type says so. Without
    // it, the shared ESLint base's no-unnecessary-condition calls a guard for a missing
    // row or key needless, and removing one would be a bug (Kindred Nights' pilot: 26 of
    // its 30 findings were guards like that, all needed).
    "noUncheckedIndexedAccess": true
  }
}
