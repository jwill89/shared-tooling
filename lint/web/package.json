{
  "name": "@jwill89/lint-web",
  "version": "2.9.0",
  "description": "Shared ESLint, Prettier, Stylelint and tsconfig for jwill89 front ends (Vue 3 + TypeScript, plus React and plain JavaScript variants).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": "./eslint.js",
    "./react": "./eslint-react.js",
    "./js": "./eslint-js.js",
    "./prettier": {
      "types": "./prettier.d.ts",
      "default": "./prettier.js"
    },
    "./stylelint": "./stylelint.js",
    "./stylelint/tailwind": "./stylelint-tailwind.js",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.vitest.json": "./tsconfig.vitest.json"
  },
  "files": [
    "eslint.js",
    "eslint-react.js",
    "eslint-js.js",
    "prettier.js",
    "prettier.d.ts",
    "stylelint.js",
    "stylelint-tailwind.js",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "tsconfig.vitest.json"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  }
}
