<Project>
  <!--
    The .NET analyzers at their recommended level, and the code style in .globalconfig
    checked in the build, for every C# project. Import it from the project's own
    Directory.Build.props:

      <Import Project="$(MSBuildThisFileDirectory)..\shared\lint\dotnet\analyzers.props" />

    The documentation file is made only so the build can see unused usings (IDE0005);
    nothing reads it, so it stays in obj/ rather than being copied beside the DLL, where
    DalamudPackager would put it in latest.zip.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).globalconfig" />
  </ItemGroup>
</Project>
